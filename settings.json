{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "WATERMARKS_HOOK_MODE": "clean",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "Bash(rtk read *)",
      "Bash(rtk grep *)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(.nuxt/**)",
      "Read(.output/**)",
      "Read(dist/**)",
      "Read(.data/**)",
      "Read(.cache/**)",
      "Grep(node_modules/**)",
      "Grep(.nuxt/**)",
      "Grep(.output/**)",
      "Grep(dist/**)",
      "Grep(.data/**)",
      "Grep(.cache/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "claude-mem:babysit": "off",
    "claude-mem:ccs-align": "off",
    "claude-mem:cloud-sync": "off",
    "claude-mem:design-is": "off",
    "claude-mem:do": "off",
    "claude-mem:how-it-works": "off",
    "claude-mem:knowledge-agent": "off",
    "claude-mem:learn-codebase": "off",
    "claude-mem:make-plan": "off",
    "claude-mem:mode-creator": "off",
    "claude-mem:oh-my-issues": "off",
    "claude-mem:pathfinder": "off",
    "claude-mem:smart-explore": "off",
    "claude-mem:standup": "off",
    "claude-mem:timeline-report": "off",
    "claude-mem:version-bump": "off",
    "claude-mem:weekly-digests": "off",
    "claude-mem:what-the": "off",
    "claude-mem:wowerpoint": "off",
    "caveman:caveman-commit": "off",
    "caveman:caveman-compress": "off",
    "caveman:caveman-discover": "off",
    "caveman:caveman-evidence-review": "off",
    "caveman:caveman-explore": "off",
    "caveman:caveman-help": "off",
    "caveman:caveman-learn": "off",
    "caveman:caveman-manage": "off",
    "caveman:caveman-optimize": "off",
    "caveman:caveman-review": "off",
    "caveman:caveman-setup": "off",
    "caveman:caveman-stats": "off",
    "caveman:investigate-first": "off",
    "caveman:lean-build": "off",
    "caveman:migration": "off",
    "caveman:safe-refactor": "off",
    "caveman:surgical-patch": "off",
    "caveman:verify-and-stop": "off",
    "caveman:caveman-init": "off",
    "superpowers:diagnosing-superpowers": "off",
    "superpowers:writing-skills": "off",
    "superpowers:dispatching-parallel-agents": "off",
    "superpowers:executing-plans": "off",
    "impeccable:impeccable": "off",
    "watermarks-remover:clean-user-facing-text": "off",
    "watermarks-remover:remove-ai-marks": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:skill-creator": "off",
    "context-audit": "off",
    "domain-modeling": "off",
    "grilling": "off",
    "prototype": "off",
    "blast-radius": "off",
    "cleanup-session-codebase": "off",
    "cleanup-whole-codebase": "off",
    "setup-matt-pocock-skills": "off",
    "wayfinder": "off",
    "wizard": "off",
    "codebase-design": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/patch-claude-mem-quota.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-env-access.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/require-ponytail.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/inject-ponytail-agent.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@superpowers-dev": true,
    "claude-mem@thedotmack": true,
    "impeccable@impeccable": true,
    "watermarks-remover@watermarks-remover": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "watermarks-remover": {
      "source": {
        "source": "github",
        "repo": "guillaumemeyer/watermarks-remover"
      }
    }
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 300000,
  "advisorModel": "opus",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
