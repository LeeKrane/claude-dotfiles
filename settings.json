{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "WATERMARKS_HOOK_MODE": "clean",
    "ANTHROPIC_BASE_URL": "http://localhost:3456",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "Bash(rtk read *)",
      "Bash(rtk grep *)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(.nuxt/**)",
      "Read(.output/**)",
      "Read(dist/**)",
      "Read(.data/**)",
      "Read(.cache/**)",
      "Grep(node_modules/**)",
      "Grep(.nuxt/**)",
      "Grep(.output/**)",
      "Grep(dist/**)",
      "Grep(.data/**)",
      "Grep(.cache/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@superpowers-dev": true,
    "claude-mem@thedotmack": true,
    "impeccable@impeccable": true,
    "watermarks-remover@watermarks-remover": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "watermarks-remover": {
      "source": {
        "source": "github",
        "repo": "guillaumemeyer/watermarks-remover"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
