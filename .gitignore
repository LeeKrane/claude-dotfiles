# Allowlist: ignore everything, un-ignore only portable config.
*

!.gitignore
!README.md
!SETUP.md
!CHANGELOG.md
!REPO-SKILLS.md

!CLAUDE.md
!settings.json
!statusline-command.sh

!hooks/
!hooks/**

# Project settings and rules for this repo only. Never track .claude/worktrees/.
!.claude/
!.claude/settings.json
!.claude/CLAUDE.md

!commands/
!commands/**

!skills/
!skills/**

# Adapted copies of repo-scoped skills (REPO-SKILLS.md Enable).
!vendor/
!vendor/**

# Never track, even if a broad "!" rule is added above.
.credentials.json
daemon/control.key
sessions/*.key
settings.local.json
settings.json.bak*

# machine-local installed dotfiles version (never track)
.dotfiles-version
# skills auto-synced from claude.ai (runtime cache)
skills/synced/
